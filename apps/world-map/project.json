{
  "name": "world-map",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/world-map/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {},
      "configurations": {
        "production": {
          "target": "world-map:esbuild:production"
        },
        "development": {
          "target": "world-map:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production",
      "outputs": ["{workspaceRoot}/dist/apps/world-map"]
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "world-map:serve-original:development",
        "rebuildDelay": 500,
        "dev": true,
        "cacheExternalArtifacts": false,
        "port": 4204
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "world-map:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/world-map/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "world-map:build",
        "port": 4200,
        "staticFilePath": "dist/apps/world-map/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/world-map",
        "index": "apps/world-map/src/index.html",
        "browser": "apps/world-map/src/main.ts",
        "polyfills": ["zone.js", "es-module-shims"],
        "tsConfig": "apps/world-map/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/world-map/public"
          }
        ],
        "styles": ["apps/world-map/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-original": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "world-map:esbuild:production"
        },
        "development": {
          "buildTarget": "world-map:esbuild:development"
        },
        "docker": {
          "buildTarget": "world-map:esbuild:development",
          "host": "0.0.0.0",
          "allowedHosts": true
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4204
      }
    }
  }
}
